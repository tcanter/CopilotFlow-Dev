{
  "name": "copilotflow-starter",
  "version": "1.0.1",
  "description": "AI-Powered Development Starter Kit",
  "main": "scripts/setup-project.js",
  "scripts": {
    "start": "node scripts/setup-project.js",
    "dev": "npm run setup",
    "build": "npm run build:clean && npm run build:compile",
    "build:clean": "rimraf dist",
    "build:compile": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "node scripts/universal-runner.js lint",
    "lint:fix": "eslint . --ext .js,.ts,.tsx --fix",
    "format": "prettier --write \"**/*.{js,ts,json,md}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{js,ts,json,md}\" --ignore-path .gitignore",
    "setup": "node scripts/setup-project.js",
    "cleanup": "node scripts/cleanup-project.js",
    "cleanup:backup": "node scripts/cleanup-project.js --backup-only",
    "cleanup:restore": "node scripts/cleanup-project.js --restore",
    "cleanup:list": "node scripts/cleanup-project.js --list-backups",
    "cleanup:manage": "node scripts/cleanup-project.js --manage-backups",
    "ai:daily-workflow": "node scripts/universal-runner.js ai:daily-workflow",
    "ai:analyze-code": "node scripts/universal-runner.js ai:analyze-code",
    "ai:generate-docs": "node scripts/universal-runner.js ai:generate-docs",
    "ai:commit-message": "node scripts/ai-automation/generate-commit.js",
    "ai:code-review": "node scripts/ai-automation/code-review.js",
    "ai:refactor-suggestions": "node scripts/ai-automation/refactor-suggestions.js",
    "qa:validate": "node scripts/qa-validation.js",
    "qa:fix": "node scripts/qa-validation.js --fix",
    "qa:pre-commit": "npm run qa:validate && npm run lint && npm run test",
    "qa:pre-deploy": "npm run qa:validate && npm run lint && npm run test && npm run build",
    "deploy:dev": "node scripts/deployment/deploy-dev.js",
    "deploy:prod": "node scripts/deployment/deploy-prod.js",
    "logs:view": "node scripts/view-logs.js",
    "logs:analyze": "node scripts/ai-automation/analyze-logs.js"
  },
  "keywords": ["ai", "automation", "development", "copilot", "starter-kit", "productivity"],
  "author": "CopilotFlow Team",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "fs-extra": "^11.1.1",
    "inquirer": "^12.9.2",
    "openai": "^4.20.1",
    "simple-git": "^3.20.0",
    "winston": "^3.11.0",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.7",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.9.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "jest": "^29.7.0",
    "js-yaml": "^4.1.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.1.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tcanter/CopilotFlow.git"
  },
  "bugs": {
    "url": "https://github.com/tcanter/CopilotFlow/issues"
  },
  "homepage": "https://github.com/tcanter/CopilotFlow#readme"
}
