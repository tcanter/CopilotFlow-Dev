# CopilotFlow Environment Configuration

# Project Information
PROJECT_NAME=CopilotFlow
PROJECT_DESCRIPTION="An AI-powered project built with CopilotFlow"
VERSION=1.0.0
ENVIRONMENT=development

STORAGE_ACCOUNT_NAME=<your_storage_account_name_here>
RESOURCE_GROUP=<your_resource_group_name_here>
LOCATION_ID=<your_location_id_here>

# AI Configuration
AI_ENABLED=true
AI_PROVIDER=OpenAI
AI_MODEL=gpt-4
OPENAI_API_KEY=your_openai_api_key_here

# Azure OpenAI Configuration (alternative to OpenAI)
# AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_VERSION=2024-12-01-preview
# AZURE_OPENAI_DEPLOYMENT_NAME=your_deployment_name

# AI Testing & Development
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=2000
AI_DEBUG=false

# Output Configuration
OUTPUT_VERBOSE=true
SAVE_AI_CONVERSATIONS=true

# Python Settings
PYTHONPATH=.
LOG_LEVEL=INFO

# Database (if applicable)
# DATABASE_URL=sqlite:///./database.db

# Add your environment variables here
