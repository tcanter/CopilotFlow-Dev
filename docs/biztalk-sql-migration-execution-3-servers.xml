      <Type>0</Type><IsNull>0</IsNull><CreateDate>2026-05-02T08:00:00</CreateDate>
      <WBS>1.6</WBS><OutlineNumber>1.6</OutlineNumber><OutlineLevel>2</OutlineLevel>
