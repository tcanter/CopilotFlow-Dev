# Logic App & Azure Function Agentic Workflow Configuration
# Azure Tenant Details
TENANT_DOMAIN=<your-tenant-domain>
TENANT_DIRECTORY_ID=<your-tenant-directory-id>
TENANT_NAME=<your-tenant-name>

# Azure OpenAI
AI_PROVIDER=Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://<your-azure-openai-endpoint>
AZURE_OPENAI_API_KEY=<your-azure-openai-api-key>
AZURE_OPENAI_API_VERSION=2023-05-01
AZURE_OPENAI_DEPLOYMENT_NAME=<your-deployment-name>

# OpenAI (if not using Azure)
OPENAI_API_KEY=<your-openai-api-key>
AI_MODEL=gpt-4

# Logic App Function URLs
AZURE_FUNCTION_ANALYZE_CODE_URL=https://<function-app-url>/api/analyze-code
AZURE_FUNCTION_QA_REVIEW_URL=https://<function-app-url>/api/qa-review
AZURE_FUNCTION_UPDATE_DOCS_URL=https://<function-app-url>/api/update-docs
AZURE_FUNCTION_GENERATE_TESTS_URL=https://<function-app-url>/api/generate-tests

# Developer Agent Connection (e.g., Teams, Email, API)
DEVELOPER_AGENT_CONNECTION=<connection-name>

# QA Agent Connection (if needed)
QA_AGENT_CONNECTION=<connection-name>

# Other configuration as needed

# Note: Update these values at runtime to match deployed Logic Apps and Functions.
